# ==============================================================================
# BPS RAG & AI CHATBOT CONFIGURATION (.env.example)
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=your_postgres_host
DB_PORT=5432
DB_DATABASE=bps_rag3321
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_TIMEOUT=10

# --- LLM PROVIDER SELECTION ---
# Options: gemini (default), openai, groq, ollama, mock
LLM_PROVIDER=gemini

# --- 1. GOOGLE GEMINI (Rekomendasi, Cepat & Akurat) ---
# Dapatkan API key di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 2. OPENAI (Opsional jika ingin GPT-4o) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- 3. GROQ (Opsional jika ingin ultra-fast Llama-3) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- 4. OLLAMA LOCAL LLM (Opsional jika ingin offline 100%) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- RAG RETRIEVAL PARAMETERS ---
TOP_K_CHUNKS=4
SCORE_THRESHOLD=0.30
MAX_TABLE_ROWS_IN_CONTEXT=20
DEFAULT_REGION="Kabupaten Demak"

# --- SIPETRA SSO BPS DEMAK (OAuth2) ---
SIPETRA_CLIENT_ID=your_client_id_here
SIPETRA_CLIENT_SECRET=your_client_secret_here
SIPETRA_REDIRECT_URI=http://localhost:8000/api/auth/sipetra/callback
SIPETRA_BASE_URL=https://bpsdemak.com
ADMIN_JWT_SECRET=your_jwt_secret_key_here
APP_PORT=8001
